<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="create-reservation-table" author="generated">

        <createTable tableName="reservation">

            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="court_id" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="customer_id" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="game_type" type="VARCHAR(20)">
                <constraints nullable="false" checkConstraint="game_type IN ('SINGLES', 'DOUBLES')" />
            </column>

            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="start_time" type="TIME">
                <constraints nullable="false"/>
            </column>

            <column name="end_time" type="TIME">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="price" type="DECIMAL(19,2)">
                <constraints nullable="true"/>
            </column>

            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="reservation"
                baseColumnNames="court_id"
                referencedTableName="court"
                referencedColumnNames="id"
                constraintName="fk_reservation_court"/>

        <addForeignKeyConstraint
                baseTableName="reservation"
                baseColumnNames="customer_id"
                referencedTableName="customer"
                referencedColumnNames="id"
                constraintName="fk_reservation_customer"/>

        <createIndex indexName="idx_reservation_court_date" tableName="reservation">
            <column name="court_id"/>
            <column name="date"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>