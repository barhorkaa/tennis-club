@startuml

left to right direction

actor Customer
actor Admin

rectangle "Tennis Club System" {

    usecase "Create Reservation" as UC1
    usecase "Cancel Reservation" as UC2
    usecase "View Reservations" as viewRes
    usecase "View Reservations by Court" as UC3
    usecase "View Reservations by Phone Number" as UC4

    usecase "Create Court" as UC5
    usecase "Update Court" as UC6
    usecase "Delete Court (soft delete)" as UC7
    usecase "List Courts" as UC8

    usecase "Create Surface Type" as UC9
    usecase "Update Surface Type" as UC10
    usecase "Delete Surface Type (soft delete)" as UC11

    usecase "Auto-create Customer if not exists" as UC12
    usecase "Validate Time Overlap" as UC13
    usecase "Calculate Reservation Price" as UC14
}

Admin --|> Customer

Customer --> UC1
Customer --> UC2
Customer -> viewRes
Customer -> UC4
Customer -> UC3

Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11

UC1 ..> UC12 : <<include>>
UC1 ..> UC13 : <<include>>
UC1 ..> UC14 : <<include>>

@enduml